{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "helm-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--host"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "helm-web-localauth",
